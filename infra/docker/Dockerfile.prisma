FROM node:22-bookworm-slim

ARG TZ=Europe/Moscow
ENV TZ=${TZ}
ENV NODE_ENV=development

RUN apt-get update \
  && apt-get install -y --no-install-recommends tzdata ca-certificates openssl \
  && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
  && echo "${TZ}" > /etc/timezone \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /prisma

# Runtime-only image: app code and node_modules are bind-mounted from the host.
# Prisma Studio out of the box.
CMD ["npx", "prisma", "studio", "--port", "5555", "--browser", "none"]
